# Copy to .env and supply your own credentials. Never commit .env.
NODE_ENV=development
PORT=3000
VITE_APP_ID=replace-with-your-oauth-project-id
VITE_APP_TITLE=ARCANE
VITE_APP_LOGO=/arcane-avocado.svg
VITE_OAUTH_PORTAL_URL=https://replace-with-oauth-portal.example
OAUTH_SERVER_URL=https://replace-with-oauth-service.example
JWT_SECRET=replace-with-random-secret-at-least-32-characters
DATABASE_URL=mysql://replace-user:replace-password@127.0.0.1:3306/arcane
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=https://replace-with-your-provider.example
BUILT_IN_FORGE_API_KEY=replace-with-your-server-key
# Set this explicitly; an empty model delegates selection to the provider.
BUILT_IN_FORGE_MODEL=
# Optional authenticated HTTPS POST {path} adapter. Without it failed uploads
# remain inaccessible and queued for cleanup rather than assuming a Forge API.
STORAGE_DELETE_URL=
# Exact comma-separated public object keys only; no wildcard/prefix matching.
PUBLIC_STORAGE_KEYS=
# Number of trusted reverse proxies; never enable for arbitrary forwarded headers.
TRUST_PROXY_HOPS=0
# Optional installed Chromium/Chrome executable used by the isolated QA worker.
ARCANE_BROWSER_EXECUTABLE=
# Single-process conservative safety caps, reset daily at 00:00 UTC.
GENERATION_ANON_DAILY_LIMIT=3
GENERATION_USER_DAILY_LIMIT=30
GENERATION_ANON_CONCURRENCY=1
GENERATION_USER_CONCURRENCY=2
GENERATION_GLOBAL_CONCURRENCY=4
GENERATION_GLOBAL_DAILY_LIMIT=200
# Strictly positive integer; invalid/zero values fall back to 64000.
GENERATION_TOKEN_RESERVE=64000
GENERATION_GLOBAL_DAILY_TOKENS=2000000
# Browser validation is independent of model calls and token budgets.
VALIDATION_USER_DAILY_LIMIT=60
VALIDATION_USER_CONCURRENCY=1
# Hard worker ceiling is two; this setting may only lower that ceiling.
VALIDATION_GLOBAL_CONCURRENCY=2
VALIDATION_GLOBAL_DAILY_LIMIT=400

# Alipay Vibe Pay basic web collection. Disabled until merchant and pricing are configured.
# Never place merchant private keys in VITE_* variables or browser code.
ALIPAY_ENABLED=false
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS1
# Public HTTPS origin; sandbox localhost HTTP can use manual order reconciliation.
PAYMENT_PUBLIC_BASE_URL=
# Required server-owned pricing, amounts in integer fen. Empty means no sales.
# Example only: [{"id":"starter","name":"创作体验包","credits":10,"amountFen":990,"currency":"CNY"}]
PAYMENT_PACKAGES_JSON=
